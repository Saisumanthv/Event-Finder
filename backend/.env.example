# GOOGLE_API_KEY=your_key_here

# Only needed when the frontend is deployed: its address, comma-separated, no path.
# Defaults to http://localhost:5173 for local development.
# ALLOWED_ORIGINS=https://your-frontend.onrender.com

# Scheduled refresh of the listings: times of day (HH:MM, comma-separated) in the time zone below.
# The first time also refreshes courses; the others refresh events and hackathons only.
# REFRESH_TIMES=06:00,12:00,18:00
# REFRESH_TIMEZONE=Asia/Kolkata

# Secret for POST /refresh (send it as the X-Refresh-Token header), so an outside scheduler
# such as cron-job.org can trigger a refresh and wake a sleeping host. The endpoint is off without it.
# REFRESH_TOKEN=a-long-random-string

# Optional: enables "Find top videos" in the Prep Map (YouTube Data API v3 key)
# YOUTUBE_API_KEY=API_KEY
# YOUTUBE_DAILY_LIMIT=90
